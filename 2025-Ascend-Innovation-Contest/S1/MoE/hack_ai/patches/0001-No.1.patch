+    # @mindspore.jit(jit_config=mindspore.JitConfig(jit_syntax_level='STRICT'))
+    def test2(self, all_idx, routing_weights, hidden_states, hidden_dim,
+              gate_proj1, up_proj1, down_proj1, gate_proj2, up_proj2, down_proj2,
+              gate_proj3, up_proj3, down_proj3, gate_proj4, up_proj4, down_proj4):
+        
+        current_state = hidden_states[None, 0].reshape(-1, hidden_dim)
+        
+        i = 0
+        idx1 = all_idx[i:i+1]
+        i = 1
+        idx2 = all_idx[i:i+1]
+        i = 2
+        idx3 = all_idx[i:i+1]
+        i = 3
+        idx4 = all_idx[i:i+1]
+        
+        r1 = routing_weights[0, idx1, None]
+        r2 = routing_weights[0, idx2, None]
+        r3 = routing_weights[0, idx3, None]
+        r4 = routing_weights[0, idx4, None]
+        
+        g1 = F.linear(current_state, gate_proj1, None)
+        g2 = F.linear(current_state, gate_proj2, None)
+        g3 = F.linear(current_state, gate_proj3, None)
+        g4 = F.linear(current_state, gate_proj4, None)
+        
+        u1 = F.linear(current_state, up_proj1, None)
+        u2 = F.linear(current_state, up_proj2, None)
+        u3 = F.linear(current_state, up_proj3, None)
+        u4 = F.linear(current_state, up_proj4, None)
+        
+        a1 = self.act(g1)
+        a2 = self.act(g2)
+        a3 = self.act(g3)
+        a4 = self.act(g4)
+        
+        u1 = u1*a1
+        u2 = u2*a2
+        u3 = u3*a3
+        u4 = u4*a4
+        
+        d1 = F.linear(u1, down_proj1, None)
+        d2 = F.linear(u2, down_proj2, None)
+        d3 = F.linear(u3, down_proj3, None)
+        d4 = F.linear(u4, down_proj4, None)
+        
+        current_hidden_states1 = d1*r1
+        current_hidden_states2 = d2*r2
+        current_hidden_states3 = d3*r3
+        current_hidden_states4 = d4*r4
+        
+        current_hidden_states = current_hidden_states1+current_hidden_states2+current_hidden_states3+current_hidden_states4
+        
+        final_hidden_states = mindspore.mint.unsqueeze(current_hidden_states.to(hidden_states.dtype), dim=0)
+        
+        return final_hidden_states
+    
     def forward(self, hidden_states: mindspore.Tensor) -> mindspore.Tensor:
         batch_size, sequence_length, hidden_dim = hidden_states.shape
         hidden_states = hidden_states.view(-1, hidden_dim)
